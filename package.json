{
  "name": "pr-review-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "description": "GitHub Action: user authorization + trigger gate for the AI PR review agent",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify-dist": "pnpm build && git diff --exit-code -- dist"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@earendil-works/gondolin": "^0.12.0",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "ajv": "^8.20.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
